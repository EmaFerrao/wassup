#!/bin/sh
# Launch the client from any directory. `--import tsx` lets Node find tsx by its own resolution, wherever npm put
# it: in our node_modules (a clone), or hoisted above us (installed with npm -g or run with npx). The symlink npm (or
# you) put on the PATH is followed to the real script by hand: `readlink -f` isn't on macOS before 12.3.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
cd "$(dirname "$self")" && exec node --import tsx src/main.ts "$@"
